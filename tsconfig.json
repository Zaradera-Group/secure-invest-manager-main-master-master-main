{
  "compilerOptions": {
    "baseUrl": ".",

    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",

    "allowJs": true,

    "strict": false,
    "strictNullChecks": false,

    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "skipLibCheck": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "types": ["node"],

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "files": [],

  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],

  "exclude": [
    "supabase/functions/**/*",
    "node_modules"
  ]
}