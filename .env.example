# Auth0 isolated test path. These are public SPA identifiers, never client secrets.
# Keep VITE_AUTH0_TEST_ENABLED=false until the Auth0 application is configured.
VITE_AUTH0_TEST_ENABLED=false
VITE_AUTH0_TEST_DOMAIN=
VITE_AUTH0_TEST_CLIENT_ID=
VITE_AUTH0_TEST_AUDIENCE=
VITE_AUTH0_TEST_ROLES_CLAIM=https://zaraderavest.com/roles
# The existing Render backend URL is required only for the read-only /auth/me check.
VITE_CERTIFICATE_API_URL=

# Render only. Keep AUTH_MODE=supabase until the Auth0 configuration is complete.
# These must never be prefixed with VITE_.
AUTH_MODE=supabase
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=https://api.zaraderavest.com
AUTH0_ROLES_CLAIM=https://zaraderavest.com/roles
AUTH0_EMAIL_CLAIM=https://zaraderavest.com/email
# Keep false until the browser login has moved to Auth0 and end-to-end validation is scheduled.
AUTH0_WORKFLOW_ACCESS_ENABLED=false
# Render only. Keeps Auth0-to-internal staff mappings current when staff access or roles change.
AUTH0_STAFF_ACCOUNTS_MONGO_RECONCILIATION_ENABLED=true
AUTH0_STAFF_ACCOUNTS_MONGO_RECONCILIATION_CRON=*/5 * * * *

# Render only. Enable temporarily during end-to-end migration checks and protect with a random secret.
MIGRATION_HEALTH_CHECK_ENABLED=false
MIGRATION_HEALTH_CHECK_TOKEN=

# Render only. Passport storage must never be exposed to Vite.
INVESTOR_PASSPORT_STORAGE_BUCKET=investor-passports

# Render only. Passport uploads use the selected STORAGE_PROVIDER. Keep this bucket only while STORAGE_PROVIDER=supabase.
# With STORAGE_PROVIDER=s3, passport files are stored privately in S3 beneath S3_PREFIX/passports/.

# Render only. Keep Supabase as the public-intake inbox read source until MongoDB reconciliation is complete.
PUBLIC_INTAKE_MONGO_READ_MODE=supabase

# Render only. Public-intake OTP records are short-lived and now use MongoDB by default.
# Supabase remains an automatic fallback only when MongoDB is unavailable.
PUBLIC_INTAKE_OTP_STORAGE_MODE=mongo

# Render only. Keep Supabase as the investor read source until MongoDB reconciliation is complete.
WORKFLOW_DATA_MONGO_READ_MODE=supabase

# Render only. Keep Supabase as the certificate list and latest-certificate read source until MongoDB reconciliation is complete.
CERTIFICATES_MONGO_READ_MODE=supabase

# Render only. Keep Supabase as the announcement read source until MongoDB reconciliation is complete.
ANNOUNCEMENTS_MONGO_READ_MODE=supabase
# Render only. Switch to mongo only after the announcement backfill and audit pass.
# Mongo-primary announcements do not write back to Supabase.
ANNOUNCEMENTS_DATA_SOURCE=supabase

# Render only. Keep Supabase as the staff directory read source until MongoDB reconciliation is complete.
STAFF_DIRECTORY_MONGO_READ_MODE=supabase

# Render only. Keep Supabase as the dashboard-notification read source until MongoDB reconciliation is complete.
NOTIFICATIONS_MONGO_READ_MODE=supabase

# Render only. Keep Supabase as the notification-preferences read source until MongoDB reconciliation is complete.
NOTIFICATION_PREFERENCES_MONGO_READ_MODE=supabase

# Render only. Keep Supabase as the notification-audit history source until the MongoDB backfill and audit pass.
NOTIFICATION_AUDIT_MONGO_READ_MODE=supabase
NOTIFICATION_AUDIT_MONGO_RECONCILIATION_ENABLED=true
NOTIFICATION_AUDIT_MONGO_RECONCILIATION_CRON=*/5 * * * *

# Render only. Read-only observer for the legacy Supabase notification queue.
# It never claims jobs, updates queue records, or sends email/SMS. Keep false by default.
NOTIFICATION_WORKER_SHADOW_ENABLED=false
NOTIFICATION_WORKER_SHADOW_CRON=*/5 * * * *
# Render only. Mirrors the legacy queue into MongoDB for delivery-worker comparison.
# This does not create a MongoDB delivery worker or send any messages.
NOTIFICATION_QUEUE_MONGO_RECONCILIATION_ENABLED=true
NOTIFICATION_QUEUE_MONGO_RECONCILIATION_CRON=*/5 * * * *
# Render only. The MongoDB-native delivery outbox exists but has no live producer yet.
# Keep false: Supabase Edge remains the sole notification delivery worker.
NOTIFICATION_RENDER_WORKER_ENABLED=false
NOTIFICATION_RENDER_WORKER_CRON=*/5 * * * *
NOTIFICATION_RENDER_WORKER_BATCH_SIZE=20

# Render only. Safe shadow producer: records birthday SMS intent in MongoDB but leaves delivery unchanged.
# Shadow records are never claimable by a future live Render worker.
BIRTHDAY_OUTBOX_SHADOW_ENABLED=false
# Set to render only after the birthday outbox shadow has been accepted.
BIRTHDAY_DELIVERY_AUTHORITY=legacy

# Render only. Safe shadow producer for certificate-stage email/SMS notifications.
# It records intent only; direct certificate notification delivery remains authoritative.
CERTIFICATE_NOTIFICATION_OUTBOX_SHADOW_ENABLED=false
# Set to render only after certificate-stage shadow records have been accepted.
CERTIFICATE_NOTIFICATION_DELIVERY_AUTHORITY=legacy

# Render only. Security audit events mirror to MongoDB by default when MongoDB is configured.
SECURITY_AUDIT_MONGO_MIRROR_ENABLED=true

# Render only. Database-triggered investor audit events are reconciled into MongoDB every five minutes.
# Keep Supabase as the activity-feed source until the backfill and audit commands pass.
AUDIT_LOGS_MONGO_READ_MODE=supabase
AUDIT_LOGS_MONGO_RECONCILIATION_ENABLED=true
AUDIT_LOGS_MONGO_RECONCILIATION_CRON=*/5 * * * *
AUDIT_LOGS_MONGO_RETENTION_DAYS=365
