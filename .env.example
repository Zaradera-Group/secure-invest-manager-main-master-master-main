# Auth0 isolated test path. These are public SPA identifiers, never client secrets.
# Keep VITE_AUTH0_TEST_ENABLED=false until the Auth0 application is configured.
VITE_AUTH0_TEST_ENABLED=false
VITE_AUTH0_TEST_DOMAIN=
VITE_AUTH0_TEST_CLIENT_ID=
VITE_AUTH0_TEST_AUDIENCE=
VITE_AUTH0_TEST_ROLES_CLAIM=https://zaraderavest.com/roles
# The existing Render backend URL is required only for the read-only /auth/me check.
VITE_CERTIFICATE_API_URL=

# Render only. Keep AUTH_MODE=supabase until the Auth0 configuration is complete.
# These must never be prefixed with VITE_.
AUTH_MODE=supabase
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=https://api.zaraderavest.com
AUTH0_ROLES_CLAIM=https://zaraderavest.com/roles

# Render only. Passport storage must never be exposed to Vite.
INVESTOR_PASSPORT_STORAGE_BUCKET=investor-passports

# Render only. Keep Supabase as the public-intake inbox read source until MongoDB reconciliation is complete.
PUBLIC_INTAKE_MONGO_READ_MODE=supabase
